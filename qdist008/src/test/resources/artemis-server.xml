<configuration xmlns="urn:activemq" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
			   xsi:schemaLocation="urn:activemq /schema/artemis-configuration.xsd">
	<core xmlns="urn:activemq:core">
		<acceptors>
			<acceptor name="invm">vm://0</acceptor>
		</acceptors>
		<security-enabled>false</security-enabled>
		<persistence-enabled>false</persistence-enabled>
		<address-settings>
			<address-setting match="qdist008">
				<dead-letter-address>qdist008Bq</dead-letter-address>
				<expiry-address>qdist008Bq</expiry-address>
				<max-delivery-attempts>1</max-delivery-attempts>
			</address-setting>
		</address-settings>

		<addresses>
			<address name="qdist008">
				<anycast>
					<queue name="qdist008"/>
				</anycast>
			</address>
			<address name="qdist008FunkFeil">
				<anycast>
					<queue name="qdist008FunkFeil"/>
				</anycast>
			</address>
			<address name="qdist008Bq">
				<anycast>
					<queue name="qdist008Bq"/>
				</anycast>
			</address>
			<address name="qdist009">
				<anycast>
					<queue name="qdist009"/>
				</anycast>
			</address>
			<address name="qdist010">
				<anycast>
					<queue name="qdist010"/>
				</anycast>
			</address>
			<address name="qdist011">
				<anycast>
					<queue name="qdist011"/>
				</anycast>
			</address>
			<address name="qdist013">
				<anycast>
					<queue name="qdist013"/>
				</anycast>
			</address>
			<address name="qdist015">
				<anycast>
					<queue name="qdist015"/>
				</anycast>
			</address>
			<address name="qdist016">
				<anycast>
					<queue name="qdist016"/>
				</anycast>
			</address>
		</addresses>
	</core>
</configuration>